# Copy to .env and fill in real values (see CLAUDE.md → Setup).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/antenne_tilburg
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Newsletter email (Resend) — see docs/instructions/admin-credentials.md
RESEND_API_KEY=
NEWSLETTER_FROM=


DYMO_MODE=preview        # preview: show XML in browser | print: send to Dymo Connect
DYMO_PRINTER_NAME=       # required when DYMO_MODE=print - exact name from Dymo Connect
