#!/bin/sh
# Gate every commit on lint + the full test suite so a red state can't land.
# Activated via `git config core.hooksPath .githooks` (npm's prepare script
# wires this up on install). Bypass in a genuine emergency with `git commit -n`.
set -e

echo "pre-commit: secret scan…"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — install it (e.g. 'brew install gitleaks') before committing." >&2
  exit 1
fi
gitleaks protect --staged --redact --no-banner

echo "pre-commit: lint…"
npm run lint

echo "pre-commit: typecheck…"
npm run typecheck

echo "pre-commit: tests…"
sh scripts/run-tests.sh

echo "pre-commit: OK"
