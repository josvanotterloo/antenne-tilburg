// Antenne Tilburg — database schema
// See docs/antenne-tilburg-website-plan.md for the product/domain rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Condition {
  NEW
  SECONDHAND
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum SupplyOrderStatus {
  PENDING
  PARTIAL
  RECEIVED
}

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

// Two equal admin accounts (shop owner + builder). No role tiers.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Managed reference lists (each has its own admin CRUD) ---

model Label {
  id         String    @id @default(cuid())
  name       String    @unique
  products   Product[]
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([supplierId])
}

model Genre {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductType {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Artists are many-to-many with Product (splits, compilations,
// collaborations) via the explicit ProductArtist join below, which carries
// a `position` so display/sort order is well-defined — Prisma's implicit
// m2m can't carry that extra column.
model Artist {
  id             String          @id @default(cuid())
  name           String          @unique
  productArtists ProductArtist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductArtist {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist  @relation(fields: [artistId], references: [id])
  // 0 = primary artist. Drives display join order and mirrors into
  // Product.primaryArtistName for cheap sorting (see below).
  position  Int     @default(0)

  @@unique([productId, artistId])
  // Guards "position 0 = primary artist" at the DB level — without this,
  // nothing prevents two rows for the same product both at position 0 (or
  // any other duplicate/non-contiguous position) from a future write path
  // that doesn't go through toProductData's array-index assignment.
  @@unique([productId, position])
  @@index([productId])
  @@index([artistId])
}

// Vinyl / tape records. `price` is present now so online purchasing can be
// added later without a schema migration. "Just In" is derived from createdAt
// (< 30 days) — no manual flag.
model Product {
  id                String          @id @default(cuid())
  title             String
  productArtists    ProductArtist[]
  transactions      StockTransaction[]
  supplyOrderLines  SupplyOrderLine[]
  // Denormalized copy of the position-0 artist's name — exists purely so
  // catalog sort and the tsvector don't need a per-row join/aggregate. Kept
  // in sync on every product write and on artist rename (see lib/product-input.ts
  // and app/api/admin/artists/[id]/route.ts).
  primaryArtistName String
  catalogNumber     String?
  labelId           String
  label             Label           @relation(fields: [labelId], references: [id])
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  productTypeId     String
  productType       ProductType     @relation(fields: [productTypeId], references: [id])
  genreId           String
  genre             Genre           @relation(fields: [genreId], references: [id])
  condition         Condition
  price             Decimal         @db.Decimal(10, 2)
  description       String?
  coverImage        String?
  quantity          Int             @default(0)
  // Derived from quantity (> 0) and kept in sync by lib/stock.ts on every
  // transaction. Defaults false to match quantity's 0 default — a brand-new
  // product has no stock until a transaction (adjust/receive) gives it some.
  inStock           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Postgres full-text search column — a generated STORED tsvector defined in a
  // manual migration. Declared here as Unsupported so Prisma treats it as
  // existing (no drift) but does not try to query it directly. Covers
  // title + description only — artist matching goes through ProductArtist/
  // Artist instead (a generated column can't reference a joined table).
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([labelId])
  @@index([supplierId])
  @@index([productTypeId])
  @@index([genreId])
  @@index([condition])
  @@index([inStock])
  @@index([createdAt])
  @@index([primaryArtistName])
}

model Supplier {
  id           String        @id @default(cuid())
  name         String        @unique
  contact      String?
  supplyOrders SupplyOrder[]
  products     Product[]
  labels       Label[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SupplyOrder {
  id         String            @id @default(cuid())
  supplierId String
  supplier   Supplier          @relation(fields: [supplierId], references: [id])
  reference  String?
  notes      String?
  orderedAt  DateTime
  sentAt     DateTime?
  receivedAt DateTime?
  status     SupplyOrderStatus @default(PENDING)
  lines      SupplyOrderLine[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([supplierId])
  @@index([status])
}

// One product per order (@@unique below) — ordering more of the same record
// later means a new line on a still-PENDING order, or a new order.
model SupplyOrderLine {
  id               String             @id @default(cuid())
  supplyOrderId    String
  supplyOrder      SupplyOrder        @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int                @default(0)
  transactions     StockTransaction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([supplyOrderId, productId])
  @@index([productId])
}

// The ledger. Every row's `quantity` is the actual applied delta (see
// lib/stock.ts) — summed chronologically per product, it always equals
// that product's Product.quantity. `note` carries the adjustment reason
// (required by the /adjust route) or context for IN/OUT.
model StockTransaction {
  id                String               @id @default(cuid())
  productId         String
  product           Product              @relation(fields: [productId], references: [id])
  type              StockTransactionType
  quantity          Int
  note              String?
  supplyOrderLineId String?
  supplyOrderLine   SupplyOrderLine?     @relation(fields: [supplyOrderLineId], references: [id])
  createdAt         DateTime             @default(now())

  @@index([productId, createdAt])
  @@index([supplyOrderLineId])
}

// Blog posts (new arrivals, events, restocks). Also feeds SEO via fresh content.
model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  body           String
  coverImage     String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// Site-wide banners. Multiple can be active at once. If startsAt/endsAt are set
// the notice activates/deactivates automatically; otherwise `active` is manual.
model Notice {
  id        String    @id @default(cuid())
  message   String
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// One row per weekday (0 = Sunday ... 6 = Saturday). Times stored as "HH:MM".
model OpeningHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique
  opensAt   String
  closesAt  String
  closed    Boolean @default(false)
}

// Per-static-page SEO overrides (Home, About, FAQ, Visit, ...).
model PageSeo {
  id             String  @id @default(cuid())
  page           String  @unique
  seoTitle       String?
  seoDescription String?
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  name         String
  // AES-256-GCM ciphertext ("v1:iv:ct:tag" — see lib/email-crypto.ts). Rows
  // created before encryption hold legacy plaintext until the one-time
  // migration script runs; decryptEmail passes those through unchanged.
  email        String
  // Keyed HMAC-SHA-256 of the normalized address. Unique so signup detects
  // duplicates without a plaintext column. Nullable only for unmigrated
  // legacy rows (backfilled by scripts/encrypt-subscriber-emails.ts).
  emailHash    String?          @unique
  status       SubscriberStatus @default(PENDING)
  // Generated at signup for the confirm link; retained after confirmation so it
  // doubles as the one-click unsubscribe token.
  confirmToken String           @unique
  createdAt    DateTime         @default(now())
  // Null until the confirmation email is successfully sent. A PENDING row
  // with this still null means signup's send failed/timed out and it's
  // waiting on the admin's manual retry (POST /api/admin/newsletter/retry-pending).
  confirmEmailSentAt DateTime?
}

// Public "looking for" requests — feeds sourcing decisions.
model WantListRequest {
  id        String   @id @default(cuid())
  artist    String
  title     String
  format    String
  notes     String?
  createdAt DateTime @default(now())
}

// Reusable newsletter header/footer — written once, remembered between sends.
// Singleton: exactly one row, fixed id "singleton", written via upsert.
// updatedAt doubles as "when the template was last used/saved".
model NewsletterTemplate {
  id         String   @id
  headerText String
  footerText String
  updatedAt  DateTime @updatedAt
}
